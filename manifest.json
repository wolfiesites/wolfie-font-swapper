{
  "manifest_version": 3,
  "name": "Wolfie Font Swapper",
  "version": "1.0.0",
  "description": "Szybka podmiana i podgląd fontów (Google Fonts + fonty systemowe) na dowolnej stronie. Osobne dropdowny dla całej strony, nagłówków i akapitów.",
  "author": "Wolfie Paweł Witek",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Wolfie Font Swapper (Ctrl+Shift+L)"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Otwórz Wolfie Font Swapper"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
